# ==========================================
# JWT Configuration
# ==========================================
# Generate dengan: openssl rand -base64 64 | tr -d '\n'
# MINIMUM 64 characters (256 bits)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_64

# Access token expiration: 15 minutes (in milliseconds)
JWT_ACCESS_EXPIRATION_MS=900000

# Refresh token expiration: 7 days (in milliseconds)
JWT_REFRESH_EXPIRATION_MS=604800000

# ==========================================
# Database Configuration
# ==========================================
DB_URL=jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?prepareThreshold=0
DB_USERNAME=postgres.your_project_ref
DB_PASSWORD=your_secure_database_password

# ==========================================
# Setup Instructions
# ==========================================
# 1. Copy this file: cp .env.example .env
# 2. Generate JWT secret: openssl rand -base64 64 | tr -d '\n'
# 3. Replace CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_64 with generated secret
# 4. Update DB credentials dari Supabase dashboard
# 5. NEVER commit .env file
